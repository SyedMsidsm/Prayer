<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    tools:ignore="SpUsage,HardcodedText">
<ImageView android:id="@+id/sky_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/sky_night" android:importantForAccessibility="no" />
<ImageView android:id="@+id/sky_stars" android:layout_width="70dp" android:layout_height="50dp" android:layout_gravity="top|end" android:layout_marginTop="8dp" android:scaleType="fitXY" android:src="@drawable/ic_stars" android:importantForAccessibility="no" />
<ImageView android:id="@+id/sky_body" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="top|end" android:layout_marginTop="10dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_moon" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" >
<TextView android:id="@+id/next_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NEXT · FAJR" android:textColor="#FFFFFF" android:textSize="10dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.06" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="10dp" android:autoSizeStepGranularity="1dp" android:layout_marginEnd="34dp"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
<Chronometer android:id="@+id/countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2:14:05" android:textColor="#FFFFFF" android:textSize="22dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="13dp" android:autoSizeMaxTextSize="22dp" android:autoSizeStepGranularity="1dp" />
<TextView android:id="@+id/until_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="until adhan" android:textColor="#E6FFFFFF" android:textSize="9dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_glass" android:padding="7dp" >
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" >
<TextView android:id="@+id/adhan_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Adhan" android:textColor="#E6FFFFFF" android:textSize="9dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
<TextView android:id="@+id/adhan_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5:06 AM" android:textColor="#FFFFFF" android:textSize="13dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9dp" android:autoSizeMaxTextSize="13dp" android:autoSizeStepGranularity="1dp" />
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" >
<TextView android:id="@+id/namaz_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Namaz" android:textColor="#E6FFFFFF" android:textSize="9dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
<TextView android:id="@+id/namaz_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5:21 AM" android:textColor="#FFFFFF" android:textSize="13dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9dp" android:autoSizeMaxTextSize="13dp" android:autoSizeStepGranularity="1dp" />
</LinearLayout>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="6dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" >
<TextView android:id="@+id/date_en" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sun, 15 Nov" android:textColor="#FFFFFF" android:textSize="10dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:gravity="start" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="10dp" android:autoSizeStepGranularity="1dp" />
<TextView android:id="@+id/date_hijri" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="4 Jumada II 1448" android:textColor="#FFFFFF" android:textSize="10dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:gravity="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="10dp" android:autoSizeStepGranularity="1dp" />
</LinearLayout>
</LinearLayout>
</FrameLayout>
