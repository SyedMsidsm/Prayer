<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sky_dusk"
    android:clipToOutline="true"
    tools:ignore="HardcodedText,UnusedAttribute">

    <ImageView
        android:id="@+id/sky_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/sky_stars"
        android:layout_width="90dp"
        android:layout_height="50dp"
        android:layout_gravity="top|end"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/sky_body"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="14dp"
        android:src="@drawable/ic_sun_warm"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/content_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="13dp">

        <LinearLayout
            android:id="@+id/header_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:orientation="vertical">

            <Chronometer
                android:id="@+id/countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Maghrib in 00:11"
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:textFontWeight="800"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="none" />

            <TextView
                android:id="@+id/date_combined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Sunday, 15 Nov 2026 · 5 Jumada al-Akhirah 1448"
                android:textColor="#F2FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:textFontWeight="700"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="none" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cards_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/m1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_glass_cell"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">

                <TextView
                    android:id="@+id/m1_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Fajr"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textFontWeight="700"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="none" />

                <TextView
                    android:id="@+id/m1_adhan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:text="5:13"
                    android:textColor="#FFFFFF"
                    android:textSize="24.5sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textFontWeight="800"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="none" />

                <TextView
                    android:id="@+id/m1_namaz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Namaz 5:28"
                    android:textColor="#F2FFFFFF"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textFontWeight="700"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="none" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/m2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_glass_cell"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">

                <TextView
                    android:id="@+id/m2_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Dhuhr"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textFontWeight="700"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="none" />

                <TextView
                    android:id="@+id/m2_adhan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:text="12:22"
                    android:textColor="#FFFFFF"
                    android:textSize="24.5sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textFontWeight="800"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="none" />

                <TextView
                    android:id="@+id/m2_namaz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Namaz 12:37"
                    android:textColor="#F2FFFFFF"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textFontWeight="700"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="none" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/m3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_glass_cell"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">

                <TextView
                    android:id="@+id/m3_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Asr"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textFontWeight="700"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="none" />

                <TextView
                    android:id="@+id/m3_adhan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:text="3:36"
                    android:textColor="#FFFFFF"
                    android:textSize="24.5sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textFontWeight="800"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="none" />

                <TextView
                    android:id="@+id/m3_namaz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Namaz 3:51"
                    android:textColor="#F2FFFFFF"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textFontWeight="700"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="none" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/m4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_next"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">

                <TextView
                    android:id="@+id/m4_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Maghrib"
                    android:textColor="#2A1442"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textFontWeight="700"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="none" />

                <TextView
                    android:id="@+id/m4_adhan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:text="6:04"
                    android:textColor="#2A1442"
                    android:textSize="24.5sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textFontWeight="800"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="none" />

                <TextView
                    android:id="@+id/m4_namaz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Namaz 6:19"
                    android:textColor="#2A1442"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textFontWeight="700"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="none" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/m5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_glass_cell"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">

                <TextView
                    android:id="@+id/m5_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Isha"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textFontWeight="700"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="none" />

                <TextView
                    android:id="@+id/m5_adhan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:text="7:11"
                    android:textColor="#FFFFFF"
                    android:textSize="24.5sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textFontWeight="800"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="none" />

                <TextView
                    android:id="@+id/m5_namaz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Namaz 7:26"
                    android:textColor="#F2FFFFFF"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textFontWeight="700"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="none" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
